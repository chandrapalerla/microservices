<?xml version="1.0" encoding="UTF-8"?>
<hazelcast xmlns="http://www.hazelcast.com/schema/config"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.hazelcast.com/schema/config
                               http://www.hazelcast.com/schema/config/hazelcast-config-5.3.xsd">
    <instance-name>product-hazelcast-instance</instance-name>

    <!--
      Java serialization whitelist — every class put into a cache map must be listed here.
      Without whitelisting, Hazelcast 5 throws HazelcastSerializationException.
    -->
    <serialization>
        <java-serialization-filter defaults-disabled="false">
            <whitelist>
                <prefix>com.product</prefix>
                <prefix>org.springframework.data.domain</prefix>
                <prefix>java.</prefix>
                <prefix>sun.reflect</prefix>
            </whitelist>
        </java-serialization-filter>
    </serialization>

    <network>
        <port auto-increment="true">5703</port>
        <outbound-ports>
            <ports>0</ports>
        </outbound-ports>
        <join>
            <multicast enabled="false"/>
            <tcp-ip enabled="false"/>
        </join>
        <interfaces enabled="false">
            <interface>127.0.0.1</interface>
        </interfaces>
    </network>

    <!-- Individual product lookups — TTL 10 min, max 1000, LRU eviction -->
    <map name="products">
        <max-idle-seconds>600</max-idle-seconds>
        <time-to-live-seconds>600</time-to-live-seconds>
        <eviction eviction-policy="LRU" max-size-policy="PER_NODE" size="1000"/>
    </map>

    <!-- Paginated / search results — TTL 5 min, max 500, LRU eviction -->
    <map name="productsPage">
        <max-idle-seconds>300</max-idle-seconds>
        <time-to-live-seconds>300</time-to-live-seconds>
        <eviction eviction-policy="LRU" max-size-policy="PER_NODE" size="500"/>
    </map>

    <!-- Categories (rarely change) — TTL 30 min, max 200, LRU eviction -->
    <map name="categories">
        <max-idle-seconds>1800</max-idle-seconds>
        <time-to-live-seconds>1800</time-to-live-seconds>
        <eviction eviction-policy="LRU" max-size-policy="PER_NODE" size="200"/>
    </map>

    <management-center scripting-enabled="false"/>
</hazelcast>
