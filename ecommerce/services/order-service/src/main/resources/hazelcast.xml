<?xml version="1.0" encoding="UTF-8"?>
<hazelcast xmlns="http://www.hazelcast.com/schema/config"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.hazelcast.com/schema/config
                               http://www.hazelcast.com/schema/config/hazelcast-config-5.3.xsd">
    <instance-name>order-hazelcast-instance</instance-name>

    <!--
      Hazelcast 5 Java-serialization filter — must whitelist every class
      that is put into cache maps, otherwise HazelcastSerializationException.

      Whitelisted prefixes:
        com.order                       — OrderResponse DTOs and all domain objects
        org.springframework.data.domain — PageImpl, PageRequest, Sort, etc.
        java.                           — JDK types (ArrayList, LinkedHashMap, BigDecimal…)
        sun.reflect                     — JDK reflection internals used by serialization
    -->
    <serialization>
        <java-serialization-filter defaults-disabled="false">
            <whitelist>
                <prefix>com.order</prefix>
                <prefix>org.springframework.data.domain</prefix>
                <prefix>java.</prefix>
                <prefix>sun.reflect</prefix>
            </whitelist>
        </java-serialization-filter>
    </serialization>

    <network>
        <port auto-increment="true">5702</port>
        <outbound-ports>
            <ports>0</ports>
        </outbound-ports>
        <join>
            <multicast enabled="false"/>
            <tcp-ip enabled="false"/>
        </join>
        <interfaces enabled="false">
            <interface>127.0.0.1</interface>
        </interfaces>
    </network>

    <!-- Individual order lookups — TTL 10 min, max 1000, LRU eviction -->
    <map name="orders">
        <max-idle-seconds>600</max-idle-seconds>
        <time-to-live-seconds>600</time-to-live-seconds>
        <eviction eviction-policy="LRU" max-size-policy="PER_NODE" size="1000"/>
    </map>

    <!-- Paginated order lists — TTL 5 min, max 500, LRU eviction -->
    <map name="ordersPage">
        <max-idle-seconds>300</max-idle-seconds>
        <time-to-live-seconds>300</time-to-live-seconds>
        <eviction eviction-policy="LRU" max-size-policy="PER_NODE" size="500"/>
    </map>

    <management-center scripting-enabled="false"/>
</hazelcast>
