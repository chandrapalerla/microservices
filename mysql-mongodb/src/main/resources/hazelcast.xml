<?xml version="1.0" encoding="UTF-8"?>
<hazelcast xmlns="http://www.hazelcast.com/schema/config"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.hazelcast.com/schema/config
                               http://www.hazelcast.com/schema/config/hazelcast-config-5.3.xsd">
    <instance-name>hazelcast-instance</instance-name>

    <network>
        <port auto-increment="true">5701</port>
        <outbound-ports>
            <ports>0</ports>
        </outbound-ports>
        <join>
            <multicast enabled="false"/>
            <tcp-ip enabled="false"/>
        </join>
        <interfaces enabled="false">
            <interface>127.0.0.1</interface>
        </interfaces>
    </network>

    <!-- Map configuration for Users cache -->
    <map name="users">
        <max-idle-seconds>600</max-idle-seconds>
        <time-to-live-seconds>600</time-to-live-seconds>
        <eviction eviction-policy="LRU" max-size-policy="PER_NODE" size="1000"/>
    </map>

    <!-- Map configuration for Users Paginated cache -->
    <map name="usersPage">
        <max-idle-seconds>300</max-idle-seconds>
        <time-to-live-seconds>300</time-to-live-seconds>
        <eviction eviction-policy="LRU" max-size-policy="PER_NODE" size="500"/>
    </map>

    <!-- Map configuration for Orders cache -->
    <map name="orders">
        <max-idle-seconds>600</max-idle-seconds>
        <time-to-live-seconds>600</time-to-live-seconds>
        <eviction eviction-policy="LRU" max-size-policy="PER_NODE" size="1000"/>
    </map>

    <!-- Map configuration for Orders Paginated cache -->
    <map name="ordersPage">
        <max-idle-seconds>300</max-idle-seconds>
        <time-to-live-seconds>300</time-to-live-seconds>
        <eviction eviction-policy="LRU" max-size-policy="PER_NODE" size="500"/>
    </map>

    <!-- Management Center configuration (optional) -->
    <management-center scripting-enabled="false"/>
</hazelcast>

